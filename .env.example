# pPonto — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.

# Turso database credentials — DEVELOPMENT database
# Get the URL from: turso db show pponto
VITE_TURSO_URL=libsql://pponto-felipeumbra.aws-ap-northeast-1.turso.io

# Get a token from: turso db tokens create pponto (authentication required)
# NOTE: database-scoped token (read/write) — a management token will NOT work here.
VITE_TURSO_TOKEN=your-turso-dev-token-here

# ─────────────────────────────────────────────────────────────
# PRODUCTION database (pponto-prod) — use in CI / release builds
# URL: libsql://pponto-prod-felipeumbra.aws-ap-northeast-1.turso.io
# Create .env.production with these vars for prod deploys.
# ─────────────────────────────────────────────────────────────
# VITE_TURSO_URL_PROD=libsql://pponto-prod-felipeumbra.aws-ap-northeast-1.turso.io
# VITE_TURSO_TOKEN_PROD=your-turso-prod-token-here