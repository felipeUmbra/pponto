# Ponto Dot8 — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.

# Turso database credentials
# Get the URL from: turso db show pponto
VITE_TURSO_URL=libsql://pponto-felipeumbra.aws-ap-northeast-1.turso.io

# Get a token from: turso db tokens create pponto (authentication required)
VITE_TURSO_TOKEN=your-turso-token-here